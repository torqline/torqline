---
import { Image } from 'astro:assets';
import type { CollectionEntry } from 'astro:content';

interface Props {
  product: CollectionEntry<'products'>;
}

const { product } = Astro.props;
const formattedPrice = new Intl.NumberFormat('en-US', {
  style: 'currency',
  currency: product.data.currency,
  maximumFractionDigits: 0,
}).format(product.data.price);
---

<a
  href={`/products/${product.id}`}
  class="group block overflow-hidden rounded-sm border border-surface-2 bg-surface transition-colors hover:border-gold"
>
  <div class="aspect-[4/3] overflow-hidden">
    <Image
      src={product.data.images[0]}
      alt={product.data.name}
      width={800}
      height={600}
      class="h-full w-full object-cover transition-transform duration-500 group-hover:scale-105"
    />
  </div>
  <div class="p-5">
    <h3 class="font-display text-base uppercase tracking-wide text-paper">{product.data.name}</h3>
    <p class="mt-1 text-sm text-muted">{product.data.summary}</p>
    <p class="mt-3 font-display text-gold">{formattedPrice}</p>
  </div>
</a>
