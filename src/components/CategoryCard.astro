---
import { Image } from 'astro:assets';
import type { CollectionEntry } from 'astro:content';

interface Props {
  category: CollectionEntry<'categories'>;
}

const { category } = Astro.props;
---

<a
  href={`/categories/${category.id}`}
  class="group block overflow-hidden rounded-sm border border-surface-2 bg-surface transition-colors hover:border-gold"
>
  <div class="aspect-[4/3] overflow-hidden">
    <Image
      src={category.data.image}
      alt={category.data.name}
      width={800}
      height={600}
      class="h-full w-full object-cover transition-transform duration-500 group-hover:scale-105"
    />
  </div>
  <div class="p-5">
    <h3 class="font-display text-lg uppercase tracking-wider text-paper">{category.data.name}</h3>
    <p class="mt-2 text-sm text-muted">{category.data.description}</p>
  </div>
</a>
