---
import { getCollection } from 'astro:content';

const categories = (await getCollection('categories')).sort((a, b) => a.data.order - b.data.order);
---

<header class="sticky top-0 z-10 border-b border-surface-2 bg-ink/95 backdrop-blur">
  <div class="mx-auto flex max-w-6xl items-center justify-between px-6 py-4">
    <a href="/" class="font-display text-2xl font-semibold tracking-[0.2em] text-paper">
      TORQ<span class="text-gold">LINE</span>
    </a>
    <nav class="hidden gap-8 md:flex">
      {
        categories.map((category) => (
          <a
            href={`/categories/${category.id}`}
            class="font-display text-sm uppercase tracking-wider text-muted transition-colors hover:text-gold"
          >
            {category.data.name}
          </a>
        ))
      }
      <a
        href="/about"
        class="font-display text-sm uppercase tracking-wider text-muted transition-colors hover:text-gold"
      >
        About
      </a>
    </nav>
    <a
      href="/contact"
      class="rounded-sm border border-gold px-4 py-2 font-display text-sm uppercase tracking-wider text-gold transition-colors hover:bg-gold hover:text-ink"
    >
      Contact
    </a>
  </div>
</header>
