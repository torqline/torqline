---
import BaseLayout from '../layouts/BaseLayout.astro';
import CategoryCard from '../components/CategoryCard.astro';
import ProductCard from '../components/ProductCard.astro';
import { getCollection } from 'astro:content';

const categories = (await getCollection('categories')).sort((a, b) => a.data.order - b.data.order);
const featuredProducts = (await getCollection('products')).filter((p) => p.data.featured);
---

<BaseLayout title="TORQLINE">
  <section class="border-b border-surface-2 bg-surface">
    <div class="mx-auto max-w-6xl px-6 py-24 text-center sm:py-32">
      <p class="font-display text-sm uppercase tracking-[0.35em] text-gold">Premium Car Accessories</p>
      <h1 class="mt-4 font-display text-4xl uppercase tracking-wide text-paper sm:text-6xl">
        Built for the drive<br />that matters
      </h1>
      <p class="mx-auto mt-6 max-w-xl text-muted">
        Forged wheels, high-output lighting, and hand-finished interior accents —
        engineered for owners who don't settle for stock.
      </p>
      <a
        href="/categories/wheels"
        class="mt-8 inline-block rounded-sm bg-gold px-6 py-3 font-display text-sm uppercase tracking-wider text-ink transition-colors hover:bg-gold-dark"
      >
        Shop the collection
      </a>
    </div>
  </section>

  <section class="mx-auto max-w-6xl px-6 py-16">
    <h2 class="font-display text-2xl uppercase tracking-wide text-paper">Categories</h2>
    <div class="mt-8 grid gap-6 sm:grid-cols-2 lg:grid-cols-3">
      {categories.map((category) => <CategoryCard category={category} />)}
    </div>
  </section>

  {
    featuredProducts.length > 0 && (
      <section class="border-t border-surface-2 bg-surface">
        <div class="mx-auto max-w-6xl px-6 py-16">
          <h2 class="font-display text-2xl uppercase tracking-wide text-paper">Featured</h2>
          <div class="mt-8 grid gap-6 sm:grid-cols-2 lg:grid-cols-3">
            {featuredProducts.map((product) => <ProductCard product={product} />)}
          </div>
        </div>
      </section>
    )
  }
</BaseLayout>
